# 운영(EC2) 백엔드 환경변수 템플릿. 복사해 EC2 의 /etc/withus/withus-backend.env (권한 600, root 소유)로 둔다
# 값은 커밋하지 않는다 (CLAUDE.md 7장). systemd EnvironmentFile 형식: KEY=VALUE, 따옴표·값 뒤 주석 없음
# 출처: docs/tech/TECH_STACK.md 2.3 운영 환경변수 + 코드에만 있는 키(WITHUS_AI_TYPE 등)

# ── 프로필 (필수) ── application.yml 기본값이 local 이라 반드시 prod 로 지정한다
SPRING_PROFILES_ACTIVE=prod

# ── DB: RDS PostgreSQL 17 (필수) ──
DB_URL=jdbc:postgresql://<rds-endpoint>:5432/withus
DB_USERNAME=
DB_PASSWORD=

# ── 서명 키·솔트 (필수, 각각 32자 이상 무작위, 예: openssl rand -hex 32) ──
JWT_SECRET=
# 바꾸면 이미 나간 메일의 수신거부 링크가 모두 무효가 된다
HMAC_SECRET=
# 비우면 IP 를 솔트 없이 해시한다
TRACKING_IP_SALT=

# ── AWS (필수) ── 자격증명은 EC2 IAM 역할(DefaultCredentialsProvider)로 받는다. 키를 여기에 쓰지 않는다
AWS_REGION=ap-northeast-2
# 에디터 이미지 버킷. 객체는 images/ 아래에만 저장되고, 버킷 정책으로 images/* 만 공개 읽기
S3_BUCKET=
# SES 반송·스팸신고 SNS 토픽. 비우면 /api/webhooks/ses 가 모든 요청을 무시한다
SES_TOPIC_ARN=

# ── 공개 주소·발신 (필수) ──
# Amplify 기본 주소(https://<branch>.<app-id>.amplifyapp.com). 메일 링크·수신거부·쿠폰·추적 링크의 기준
# Amplify 를 만든 뒤에야 정해진다 — 정해지면 이 값을 넣고 백엔드를 재시작한다(infra/aws/README.md 4단계)
WITHUS_PUBLIC_BASE_URL=
# SES 에 인증한 발신 이메일 주소(샌드박스)
WITHUS_MAIL_FROM=

# ── AI ── 비우면 AI 기능이 AI_UNAVAILABLE 로 실패한다. 시연 전날 무료 한도(RPM 15, RPD 500) 확인
GEMINI_API_KEY=
# gemini(기본) | mock
WITHUS_AI_TYPE=gemini

# ── 최초 OWNER 계정 (필수, DB 에 OWNER 가 없을 때만 1회 생성) ──
OWNER_EMAIL=
OWNER_PASSWORD=

# ── 발신자 정보 (선택, 비우면 시연용 값) ── 로드맵 6장: W5 배포 전 실제 값으로 교체
# WITHUS_SENDER_NAME=위드어스
# WITHUS_SENDER_PHONE=02-000-0000
# WITHUS_SENDER_UNSUBSCRIBE_PHONE=080-000-0000

# ── F-12 수신동의 2년 안내 (선택) ── 운영 시연 제외(PL 결정 2026-10-07, backend #81). 켤 때만 true
# WITHUS_SCHEDULER_CONSENT_NOTICE_ENABLED=false
