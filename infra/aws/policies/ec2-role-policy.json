{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SendMailViaSes",
      "Effect": "Allow",
      "Action": ["ses:SendEmail", "ses:SendRawEmail"],
      "Resource": "*"
    },
    {
      "Sid": "WriteEditorImages",
      "Effect": "Allow",
      "Action": ["s3:PutObject"],
      "Resource": "arn:aws:s3:::<S3_BUCKET>/images/*"
    }
  ]
}
