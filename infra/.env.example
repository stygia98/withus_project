# 복사해서 infra/.env 로 저장한다 (.env 는 커밋 금지)
# docker compose 와 백엔드(local 프로필)가 함께 읽는다
# 주의: 값 뒤에 주석을 붙이지 않는다 (Spring 이 값으로 읽음)
POSTGRES_DB=withus
DB_USERNAME=withus
DB_PASSWORD=change-me
# PC에 PostgreSQL 이 이미 설치돼 5432 를 쓰고 있으면 5433 등으로 바꾼다
DB_PORT=5432
DB_URL=jdbc:postgresql://localhost:${DB_PORT}/withus
# JWT 서명 키: 32자 이상 무작위 문자열 (예: openssl rand -hex 32)
JWT_SECRET=change-me-to-a-random-string-of-32-chars-or-more
# 추적 이벤트 IP 해시 솔트: 무작위 문자열 (비우면 솔트 없이 해시. 운영은 반드시 설정)
TRACKING_IP_SALT=change-me-to-a-random-string
# 최초 OWNER 계정 (DB에 OWNER 가 없을 때만 생성)
OWNER_EMAIL=owner@withus.local
OWNER_PASSWORD=change-me
